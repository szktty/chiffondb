// Whitespace and comments are skipped automatically
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ "//" ~ (!"\n" ~ ANY)* }

// --- Top level ---
schema = { SOI ~ definition* ~ EOI }

definition = { node_def | edge_def }

// --- Node definition ---
node_def = {
    "node" ~ ident ~ type_params? ~ extends_clause? ~ "{" ~ field_def* ~ "}"
}

extends_clause = { "extends" ~ ident }

// --- Edge definition ---
edge_def = {
    "edge" ~ ident ~ generic_params? ~ "{" ~ edge_from ~ edge_to ~ props_block? ~ "}"
}

edge_from = { "from" ~ ":" ~ type_expr }
edge_to   = { "to"   ~ ":" ~ type_expr }

props_block = { "props" ~ ":" ~ "{" ~ field_def* ~ "}" }

// --- Field definition ---
// A field may carry trailing annotations, e.g. `name: String @index`. `@unique` is reserved
// for Phase 6 (tier-3) and parsed here so the grammar is stable, though enforcement is later.
field_def  = { ident ~ ":" ~ type_expr ~ annotation* }
annotation = { "@" ~ plain_ident }

// --- Type expressions ---
type_expr = {
    vector_type
  | list_type
  | map_type
  | node_ref_type
  | edge_ref_type
  | primitive_type
  | ident
}

// The lookahead keeps a primitive from swallowing the head of a longer user type name
// (`Integer`, `StringValue`), which would otherwise be unreferenceable.
primitive_type = @{
    ("Int" | "Float" | "Boolean" | "DateTime" | "String" | "Json" | "Blob") ~ !XID_CONTINUE
}

vector_type   = { "Vector" ~ "<" ~ integer ~ ">" }
list_type     = { "List"   ~ "<" ~ type_expr ~ ">" }
map_type      = { "Map"    ~ "<" ~ type_expr ~ "," ~ type_expr ~ ">" }
node_ref_type = { "NodeRef" ~ "<" ~ ident ~ ">" }
edge_ref_type = { "EdgeRef" ~ "<" ~ ident ~ ">" }

// --- Generics ---
// For nodes: type parameters like <K, V> (without bounds)
type_params = { "<" ~ type_param ~ ("," ~ type_param)* ~ ">" }
type_param  = { ident }

// For edges: bounded type parameters like <T: BoundType>
generic_params = { "<" ~ bound_param ~ ("," ~ bound_param)* ~ ">" }
bound_param    = { ident ~ (":" ~ ident)? }

// --- Primitives ---
// A name is either a bare Unicode identifier (UAX #31 XID, plus a leading `_`) or a
// backtick-quoted one. The quoted form follows Cypher: anything but a line break is allowed, and
// a literal backtick is written doubled. Names are compared byte-for-byte; no Unicode
// normalization is applied.
ident        = ${ quoted_ident | plain_ident }
plain_ident  = @{ (XID_START | "_") ~ XID_CONTINUE* }
quoted_ident = ${ "`" ~ quoted_body ~ "`" }
quoted_body  = @{ ("``" | !("`" | "\n" | "\r") ~ ANY)+ }

// Used by the unparser to decide whether a name can be written bare.
bare_name = { SOI ~ plain_ident ~ EOI }
integer = @{ ASCII_DIGIT+ }
